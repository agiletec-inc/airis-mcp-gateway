# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must have Unix line endings
*.sh text eol=lf

# Python files
*.py text eol=lf

# Docker files
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Config files that may be used in containers
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Makefiles and task files
Makefile text eol=lf
Taskfile.yml text eol=lf

# Keep Windows batch files with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
