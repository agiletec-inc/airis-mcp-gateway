apps/api/requirements.lock.txt
secrets.json

# Local editor installation state
.installed_editors.json

# Serena memory (local AI context)
.serena/

# Casks (local macOS app builds)
Casks/

# Git worktrees
.worktrees/
.claude/worktrees/

# Gemini CLI
.gemini/

# Binary artifacts
mcp-publisher

# Lock files — the TypeScript apps use a single pnpm workspace (issue #81).
# The root pnpm-lock.yaml is tracked; reject any stray npm lockfiles that
# show up from a developer running npm by accident.
package-lock.json
apps/*/package-lock.json
