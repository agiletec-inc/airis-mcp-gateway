servers/*/node_modules/
apps/*/node_modules/
node_modules/
.pnpm-store/

# Build outputs
target/
apps/*/out/
apps/*/dist/
apps/*/build/
libs/*/dist/
packages/*/dist/
servers/*/dist/
*.tsbuildinfo

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Auto-generated
auto-imports.d.ts
.modules.yaml
.pnpm-workspace-state-v1.json
.airis/

